[
  {
    "name": "OnProductImageUploaded",
    "scriptFile": "ABCRetailFunctions.dll",
    "entryPoint": "ABCRetail.Functions.BlobFunctions.OnProductImageUploaded",
    "language": "dotnet-isolated",
    "properties": {
      "IsCodeless": false
    },
    "bindings": [
      {
        "name": "blob",
        "direction": "In",
        "type": "blobTrigger",
        "path": "%BLOB_PRODUCT_IMAGES%/{name}",
        "connection": "STORAGE_CONNECTION",
        "properties": {
          "supportsDeferredBinding": "True"
        }
      }
    ]
  },
